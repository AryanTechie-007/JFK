{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "function": "sentinel_run_velocity_projection",
  "c3_spec": {
    "params": { "category_scope": "array of category_id | \"ALL_CAPPED\"" },
    "data": {
      "days_elapsed": "int",
      "days_remaining": "int",
      "categories": [
        {
          "category_id": "str",
          "daily_burn_minor": "int",
          "projected_month_end_minor": "int",
          "pacing": "UNDER|ON_TRACK|OVER|null",
          "safe_daily_envelope_minor": "int|null",
          "conservative_daily_envelope_minor": "int|null"
        }
      ]
    }
  },
  "params": {
    "type": "object",
    "properties": {
      "category_scope": { "type": ["array", "string"] }
    },
    "additionalProperties": true
  },
  "data": {
    "type": "object",
    "required": ["days_elapsed", "days_remaining", "categories"],
    "properties": {
      "days_elapsed": { "type": "integer" },
      "days_remaining": { "type": "integer" },
      "categories": { "type": "array" }
    }
  }
}
