{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "function": "sentinel_get_spending_timeseries",
  "c3_spec": {
    "params": {
      "granularity": "MONTH|WEEK|DAY",
      "from_period": "YYYY-MM",
      "to_period": "YYYY-MM",
      "category_scope": "array?"
    },
    "data": {
      "buckets": [
        {
          "bucket": "YYYY-MM|YYYY-Www|YYYY-MM-DD",
          "category_id": "str|null(total)",
          "spend_signed_minor": "int"
        }
      ]
    }
  },
  "params": {
    "type": "object",
    "properties": {
      "granularity": { "type": "string", "enum": ["MONTH", "WEEK", "DAY"], "default": "MONTH" },
      "from_period": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
      "to_period": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
      "category_scope": { "type": "array", "items": { "type": "string" } }
    },
    "additionalProperties": true
  },
  "data": {
    "type": "object",
    "required": ["buckets"],
    "properties": {
      "buckets": { "type": "array" }
    }
  }
}
