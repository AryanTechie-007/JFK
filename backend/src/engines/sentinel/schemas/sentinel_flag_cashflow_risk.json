{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "function": "sentinel_flag_cashflow_risk",
  "c3_spec": {
    "params": { "horizon_days": "1..60", "outlays": "ResultRef? (fact)" },
    "data": {
      "next_income_date": "date|null",
      "spendable_balance_signed_minor": "int",
      "flags": [
        {
          "severity": "HIGH|MEDIUM|LOW",
          "gap_minor": "int",
          "first_shortfall_date": "date",
          "lead_time_days": "int"
        }
      ]
    }
  },
  "fact_params": ["outlays"],
  "params": {
    "type": "object",
    "properties": {
      "horizon_days": { "type": "integer", "minimum": 1, "maximum": 60, "default": 30 },
      "outlays": { "type": ["object", "null"] }
    },
    "additionalProperties": true
  },
  "data": {
    "type": "object",
    "required": ["next_income_date", "spendable_balance_signed_minor", "flags"],
    "properties": {
      "next_income_date": { "type": ["string", "null"] },
      "spendable_balance_signed_minor": { "type": "integer" },
      "flags": { "type": "array" }
    }
  }
}
