      "period": { "type": "string" },
      "cap_minor": { "type": ["integer", "null"] },
      "covered_category_ids": { "type": "array" },
      "spent_signed_minor": { "type": "integer" },
      "spent_total_minor": { "type": "integer" },
      "spent_settled_minor": { "type": "integer" },
      "spent_provisional_minor": { "type": "integer" },
      "utilization_bp": { "type": ["integer", "null"] },
